  "info": {
    "title": "NouriSearch API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Ready means the database answers and its schema matches the deployed code.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/foods/search": {
      "get": {
        "operationId": "search_v1_foods_search_get",
        "parameters": [
          {
            "description": "Food name to find.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Food name to find.",
              "maxLength": 200,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "description": "Excludes every other kind of food.",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/FoodTypeFilter",
              "default": "all",
              "description": "Excludes every other kind of food."
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 10000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodSearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search",
        "tags": [
          "foods"
        ]
      }
    },
    "/v1/foods/{food_id}": {
      "get": {
        "description": "Lists every tracked nutrient. A value nobody knows is null with an `unknown` status.",
        "operationId": "read_food_v1_foods__food_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "food_id",
            "required": true,
            "schema": {
              "title": "Food Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Food",
        "tags": [
          "foods"
        ]
      }
    },
    "/v1/foods/{food_id}/composition": {
      "get": {
        "description": "Everything the food page shows, including marks for every serving.",
        "operationId": "read_composition_v1_foods__food_id__composition_get",
        "parameters": [
          {
            "in": "path",
            "name": "food_id",
            "required": true,
            "schema": {
              "title": "Food Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodCompositionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Composition",
        "tags": [
          "foods"
        ]
      }
    },
    "/v1/foods/{food_id}/related": {
      "get": {
        "operationId": "read_related_v1_foods__food_id__related_get",
        "parameters": [
          {
            "in": "path",
            "name": "food_id",
            "required": true,
            "schema": {
              "title": "Food Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 6,
              "maximum": 24,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelatedFoodsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Related",
        "tags": [
          "foods"
        ]
      }
    },
    "/v1/foods/{food_id}/simulations": {
      "post": {
        "description": "Returns the composition with these edits applied. Writes nothing.",
        "operationId": "simulate_v1_foods__food_id__simulations_post",
        "parameters": [
          {
            "in": "path",
            "name": "food_id",
            "required": true,
            "schema": {
              "title": "Food Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodCompositionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Simulate",
        "tags": [
          "foods"
        ]
      }
    },
    "/v1/reference-intakes": {
      "get": {
        "description": "A nutrient with no reference at all, such as total sugars, is simply not listed.",
        "operationId": "read_reference_intakes_v1_reference_intakes_get",
        "parameters": [
          {
            "description": "The age and sex group to compare with.",
            "in": "query",
            "name": "population",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ReferencePopulation",
              "default": "general_label",
              "description": "The age and sex group to compare with."
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenceIntakesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Reference Intakes",
        "tags": [
          "reference intakes"
        ]
      }
    }
  }
}
