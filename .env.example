# Copy to .env for local overrides. Docker Compose and the backend both read it.
# These values are for local development only.

POSTGRES_USER=nourisearch
POSTGRES_PASSWORD=nourisearch_dev
POSTGRES_DB=nourisearch
POSTGRES_PORT=5433
API_PORT=8000

NOURISEARCH_ENVIRONMENT=development
NOURISEARCH_LOG_LEVEL=INFO
NOURISEARCH_LOG_FORMAT=console
NOURISEARCH_DATABASE_URL=postgresql+psycopg://nourisearch:nourisearch_dev@localhost:5433/nourisearch
